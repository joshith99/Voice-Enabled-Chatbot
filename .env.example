SARVAM_API_KEY=
SARVAM_STUB=0

# 7api (OpenAI-compatible) endpoint for the persona LLM
LLM_API_KEY=
LLM_BASE_URL=https://7api.st/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_MAX_TOKENS=1200
# JSON merged into the request body. The default disables reasoning, which this
# gateway otherwise runs by default (slow, and billed as output tokens).
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
